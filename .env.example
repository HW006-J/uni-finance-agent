# Copy this file to .env.local and fill in real values.
# .env.local is gitignored - never commit real credentials.

# --- Supabase (persistent financial state) ---------------------------------
# Project Settings -> Data API in your Supabase dashboard.
SUPABASE_URL=

# Project Settings -> API Keys -> service_role (secret). Server-only, never
# expose this to the browser. Used to bypass RLS from trusted server code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (the only LLM/voice provider used by this MVP) -----------------
# Create a free-tier key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Text/tool-calling model. Defaults to a Gemini free-tier-compatible model.
GEMINI_MODEL=gemini-2.5-flash

# Realtime voice model used by Gemini Live (see /api/voice/token). Optional -
# only needed if you want to override the default native-audio model.
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025

# NOTE: this MVP has no authentication on any route (single demo profile,
# no login). Do not deploy it to a public URL without adding an auth layer -
# see "Known limitations" in the PR description.
