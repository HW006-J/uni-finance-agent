# Copy this file to .env.local and fill in real values.
# .env.local is gitignored - never commit real credentials.

# --- Supabase (persistent financial state) ---------------------------------
# Project Settings -> Data API -> "Project URL" (NOT the "REST API URL" -
# that one already has /rest/v1 on the end; the app strips it defensively
# if you paste it anyway, but the bare project URL is the correct value).
SUPABASE_URL=

# Project Settings -> API Keys -> service_role (secret). Server-only, never
# expose this to the browser. Used to bypass RLS from trusted server code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (the only LLM provider used by this MVP) ------------------------
# Create a free-tier key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Text/tool-calling model. Defaults to a stable "lite" alias - in testing
# it had a much more generous free-tier quota than the non-lite alias.
GEMINI_MODEL=gemini-flash-lite-latest

# Voice input uses the browser's built-in speech recognition (Web Speech
# API) - no extra credential or model needed. The recognized transcript is
# submitted through the same text pipeline above.

# --- Demo access gate --------------------------------------------------------
# Not a user account system - everyone who knows this password shares the
# same single demo financial profile. Pick any password; set it directly
# in your hosting provider's dashboard for a real deployment, never commit
# it. If unset in local dev, the app skips the gate for convenience; if
# unset in production it fails closed (nobody can log in) rather than
# silently exposing the demo.
DEMO_PASSWORD=
